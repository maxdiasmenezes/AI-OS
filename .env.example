# Copy this file to .env and fill in secrets as providers need them.
# .env is git-ignored; never commit real secrets.
#
# The default provider (Ollama) runs locally and needs no key here.

# WhatsApp interface (interfaces/whatsapp/) - see interfaces/whatsapp/README.md.
# All values below are synthetic placeholders. This interface authorizes
# exactly one sender - there is no allow-list and no multi-user support.
# WHATSAPP_API_VERSION has no code default; verify the currently supported
# Cloud API version during operational setup and set it explicitly.
# The server fails fast at startup if any value is missing or invalid.
WHATSAPP_VERIFY_TOKEN=<replace-with-local-secret>
WHATSAPP_APP_SECRET=<replace-with-meta-app-secret>
WHATSAPP_ACCESS_TOKEN=<replace-with-meta-access-token>
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_AUTHORIZED_SENDER_ID=10000000000
WHATSAPP_API_VERSION=<replace-with-current-supported-version>
WHATSAPP_HOST=127.0.0.1
WHATSAPP_PORT=8000
